rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAdminRole(role) {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == role;
    }

    function isSuperAdmin() {
      return hasAdminRole('Super Admin');
    }

    function isStaff() {
      return isSuperAdmin() || hasAdminRole('Admin') || hasAdminRole('Manager');
    }

    function ownsCourt(courtId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/courts/$(courtId)) && get(/databases/$(database)/documents/courts/$(courtId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow delete: if isStaff();
    }

    match /courts/{courtId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (ownsCourt(courtId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pricePerHour', 'status', 'openingTime', 'closingTime']));
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid || ownsCourt(resource.data.courtId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.bookingStatus == 'Cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus'])) || (ownsCourt(resource.data.courtId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus']));
      allow delete: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid || ownsCourt(resource.data.courtId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'Pending';
      allow update, delete: if isStaff();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isStaff());
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
  }
}
